# 构建产物
dist/
build/
out/
*.tsbuildinfo

# 日志与临时文件
*.log
logs/
tmp/
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python 构建产物
*.egg-info/

# 验证脚本产出的截图（可复现，不入库）
deploy/verify/artifacts/
