# ===== 基础服务 =====
POSTGRES_USER=aw
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent_workbench

# ===== 后端 =====
# PostgreSQL 连接（asyncpg）
DATABASE_URL=postgresql+asyncpg://aw:change-me@localhost:5432/agent_workbench
# Redis（队列/缓存/Pub-Sub）
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# JWT
JWT_SECRET=please-change-me-to-a-random-64-char-secret
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
# 首个管理员邀请码（bootstrap 脚本使用）
INVITE_CODE=CHANGE-ME-ADMIN-CODE

# ===== MinIO（S3 兼容）=====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-workbench
MINIO_SECURE=false

# ===== LLM（LiteLLM 网关）=====
LLM_API_KEY=sk-please-change-me
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ===== 部署 =====
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
