# WorkBuddy 本地项目数据（含会话记忆等，不入库）
.workbuddy/

# 环境变量与密钥
.env
.env.*
!.env.example

# 依赖目录
node_modules/
venv/
.venv/
__pycache__/
*.py[cod]

# 构建产物
dist/
build/
out/
*.tsbuildinfo

# 日志与临时文件
*.log
logs/
tmp/
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python 构建产物
*.egg-info/

# 测试覆盖率产物（pytest-cov 生成，可复现，不入库）
.coverage
.coverage.*
htmlcov/
coverage.xml

# 验证脚本产出的截图（可复现，不入库）
deploy/verify/artifacts/

# 数据库备份（含真实数据，绝不入库；升级前的回滚保险）
backend/.backups/
*.dump

# 备份目录（含真实数据，绝不入库）
/backups/

# 验收脚本产物（截图/DOM 摘要——证据不进仓库）
deploy/verify/.artifacts/

# 数据库备份（本地证据，不进仓库）
deploy/backup/*.sql
